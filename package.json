{
  "name": "discord-account-manager",
  "private": true,
  "version": "1.5.6",
  "description": "A powerful and user-friendly Discord account manager built with Electron.js.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "package": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "discord.js-selfbot-v13": "^3.7.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.discord.accoun.tmanager",
    "productName": "Discord Account Manager",
    "win": {
      "target": "nsis",
      "icon": "src/icons/app-icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      "resources/**"
    ]
  },
  "author": "Bherl1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bherl1/DiscordAccMgr.git"
  },
  "bugs": {
    "url": "https://github.com/Bherl1/DiscordAccMgr/issues"
  },
  "homepage": "https://github.com/Bherl1/DiscordAccMgr"
}
